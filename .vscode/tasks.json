{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start B3 - photo obstacle course - original servos",
      "type": "process",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "${workspaceFolder}\\run_robot_b3.py",
        "--ramp",
        "--seconds",
        "100"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
